#!/bin/sh

# This git hook prevents pushing directly to the main branch.
# To bypass this for an emergency, you can use `git push --no-verify`.

current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" = "main" ]; then
    echo "========================================================================="
    echo "❌ ERROR: Pushing directly to the 'main' branch is not allowed!"
    echo "========================================================================="
    echo "Please follow the project workflow:"
    echo "  1. Create a new branch:  git checkout -b <branch-name>"
    echo "  2. Commit your changes:  git commit -m 'Your message'"
    echo "  3. Push the branch:      git push -u origin <branch-name>"
    echo "  4. Open a Pull Request on GitHub to merge into main."
    echo "========================================================================="
    exit 1
fi

exit 0
